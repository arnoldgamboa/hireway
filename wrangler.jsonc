{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "hireway",
  "main": "./.output/server/index.mjs",
  "compatibility_date": "2025-07-15",
  "compatibility_flags": ["nodejs_compat", "no_nodejs_compat_v2"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./.output/public"
  },
  "observability": {
    "enabled": true
  }
}
